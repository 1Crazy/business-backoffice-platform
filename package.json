{
  "name": "business-platform-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "architecture:check": "node scripts/architecture-check.cjs",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter platform-api dev",
    "dev:full": "pnpm --filter platform-api --filter main-web --filter oa-web --filter scrm-web --parallel --stream run dev",
    "dev:full:lan": "VITE_DEV_ALLOW_LAN=true pnpm --filter platform-api --filter main-web --filter oa-web --filter scrm-web --parallel --stream run dev",
    "dev:main-web": "pnpm --filter main-web dev",
    "dev:main-web:lan": "VITE_DEV_ALLOW_LAN=true pnpm --filter main-web dev",
    "dev:oa-web": "pnpm --filter oa-web dev",
    "dev:oa-web:lan": "VITE_DEV_ALLOW_LAN=true pnpm --filter oa-web dev",
    "dev:scrm-web": "pnpm --filter scrm-web dev",
    "dev:scrm-web:lan": "VITE_DEV_ALLOW_LAN=true pnpm --filter scrm-web dev",
    "docker:infra": "docker compose up -d postgres",
    "docker:infra:down": "docker compose stop postgres",
    "docker:infra:logs": "docker compose logs -f --tail=200 postgres",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "lint": "pnpm -r lint && pnpm architecture:check",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter platform-api prisma generate",
    "prisma:migrate": "pnpm --filter platform-api prisma migrate dev",
    "prisma:seed": "pnpm --filter platform-api prisma db seed"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
