generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DataScope {
  SELF
  DEPARTMENT
  DEPARTMENT_AND_SUBTREE
  ALL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum OpportunityStage {
  DISCOVERY
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentPlanStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum RenewalReminderStatus {
  PENDING
  CONTACTED
  COMPLETED
  DISMISSED
}

enum FollowUpEntityType {
  LEAD
  CUSTOMER
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

enum AuditActionType {
  SIGN_IN
  SIGN_IN_FAILED
  CREATE
  UPDATE
  DELETE
  ENABLE
  DISABLE
  ASSIGN
  CONVERT
  UPLOAD
  SESSION_REVOKE
}

enum AttachmentBusinessType {
  CUSTOMER
  LEAD
  OTHER
}

enum AttachmentStorageProvider {
  LOCAL
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdministrativeRequestType {
  REIMBURSEMENT
  TRAVEL
  PURCHASE
  SEAL
}

enum AdministrativeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdministrativeRequestActionType {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionDecision {
  APPROVED
  REJECTED
}

model Department {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  parentId  String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentHierarchy")
  users     User[]

  @@index([parentId])
  @@index([status])
}

model User {
  id                        String                    @id @default(cuid())
  username                  String                    @unique
  passwordHash              String
  displayName               String
  email                     String?
  phone                     String?
  status                    UserStatus                @default(ACTIVE)
  departmentId              String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  department                Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                     UserRole[]
  ownedCustomers            Customer[]                @relation("CustomerOwner")
  ownedLeads                Lead[]                    @relation("LeadOwner")
  ownedOpportunities        Opportunity[]             @relation("OpportunityOwner")
  followUps                 FollowUp[]                @relation("FollowUpCreator")
  reminders                 Reminder[]                @relation("ReminderOwner")
  auditLogs                 AuditLog[]                @relation("AuditActor")
  uploadedAttachments       Attachment[]              @relation("AttachmentUploader")
  sessions                  UserSession[]
  leaveRequests             LeaveRequest[]            @relation("LeaveRequestApplicant")
  approvalsToHandle         LeaveRequest[]            @relation("LeaveRequestApprover")
  leaveApprovalActions      LeaveApprovalAction[]     @relation("LeaveApprovalActor")
  administrativeRequests    AdministrativeRequest[]   @relation("AdministrativeRequestApplicant")
  administrativeApprovals   AdministrativeRequest[]   @relation("AdministrativeRequestApprover")
  administrativeActions     AdministrativeRequestAction[] @relation("AdministrativeRequestActionActor")
  opportunityStageHistories OpportunityStageHistory[] @relation("OpportunityStageHistoryCreator")
  ownedQuotes               Quote[]                   @relation("QuoteOwner")
  ownedContracts            Contract[]                @relation("ContractOwner")
  ownedPaymentPlans         PaymentPlan[]             @relation("PaymentPlanOwner")
  ownedPaymentRecords       PaymentRecord[]           @relation("PaymentRecordOwner")
  ownedRenewalReminders     RenewalReminder[]         @relation("RenewalReminderOwner")
  publishedAnnouncements    Announcement[]            @relation("AnnouncementPublisher")
  workfeedNotificationReads WorkfeedNotificationRead[] @relation("WorkfeedNotificationReader")

  @@index([departmentId])
  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  status      RecordStatus     @default(ACTIVE)
  dataScope   DataScope        @default(SELF)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@index([dataScope])
  @@index([status])
}

model Permission {
  id          String           @id @default(cuid())
  appCode     String           @default("scrm")
  name        String
  code        String           @unique
  description String?
  group       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([appCode, group])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Customer {
  id                 String                  @id @default(cuid())
  name               String
  contactName        String?
  phone              String?
  email              String?
  source             String?
  status             String?
  notes              String?
  ownerId            String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  owner              User                    @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tags               CustomerTagOnCustomer[]
  followUps          FollowUp[]              @relation("CustomerFollowUps")
  reminders          Reminder[]              @relation("CustomerReminders")
  attachments        Attachment[]            @relation("CustomerAttachments")
  opportunities      Opportunity[]
  quotes             Quote[]                 @relation("CustomerQuotes")
  contracts          Contract[]              @relation("CustomerContracts")
  paymentPlans       PaymentPlan[]           @relation("CustomerPaymentPlans")
  paymentRecords     PaymentRecord[]         @relation("CustomerPaymentRecords")
  renewalReminders   RenewalReminder[]       @relation("CustomerRenewalReminders")
  convertedFromLeads Lead[]                  @relation("LeadConvertedCustomer")

  @@index([ownerId])
  @@index([source])
  @@index([status])
}

model CustomerTag {
  id        String                  @id @default(cuid())
  name      String                  @unique
  color     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  customers CustomerTagOnCustomer[]
}

model CustomerTagOnCustomer {
  customerId String
  tagId      String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model Lead {
  id                  String        @id @default(cuid())
  name                String
  contactName         String?
  phone               String?
  source              String?
  status              LeadStatus    @default(NEW)
  notes               String?
  ownerId             String
  convertedCustomerId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  owner               User          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  convertedCustomer   Customer?     @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  followUps           FollowUp[]    @relation("LeadFollowUps")
  reminders           Reminder[]    @relation("LeadReminders")
  attachments         Attachment[]  @relation("LeadAttachments")
  sourceOpportunities Opportunity[] @relation("LeadSourceOpportunity")

  @@index([ownerId])
  @@index([source])
  @@index([status])
}

model Opportunity {
  id                String                    @id @default(cuid())
  name              String
  customerId        String
  sourceLeadId      String?
  ownerId           String
  stage             OpportunityStage          @default(DISCOVERY)
  expectedAmount    Decimal                   @db.Decimal(18, 2)
  expectedCloseDate DateTime
  nextAction        String
  notes             String?
  closedAt          DateTime?
  lostReason        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  customer          Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceLead        Lead?                     @relation("LeadSourceOpportunity", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  owner             User                      @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stageHistory      OpportunityStageHistory[]
  quotes            Quote[]                   @relation("OpportunityQuotes")
  contracts         Contract[]                @relation("OpportunityContracts")
  paymentPlans      PaymentPlan[]             @relation("OpportunityPaymentPlans")
  paymentRecords    PaymentRecord[]           @relation("OpportunityPaymentRecords")
  renewalReminders  RenewalReminder[]         @relation("OpportunityRenewalReminders")

  @@index([ownerId])
  @@index([customerId])
  @@index([sourceLeadId])
  @@index([createdAt])
  @@index([stage, expectedCloseDate])
  @@index([stage, closedAt])
}

model OpportunityStageHistory {
  id            String            @id @default(cuid())
  opportunityId String
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  comment       String?
  createdById   String
  createdAt     DateTime          @default(now())
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("OpportunityStageHistoryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([createdById])
}

model Quote {
  id            String      @id @default(cuid())
  quoteNo       String      @unique
  title         String
  amount        Decimal     @db.Decimal(18, 2)
  status        QuoteStatus @default(DRAFT)
  issuedAt      DateTime?
  expiresAt     DateTime?
  notes         String?
  customerId    String
  opportunityId String
  ownerId       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer    @relation("CustomerQuotes", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation("OpportunityQuotes", fields: [opportunityId], references: [id], onDelete: Cascade)
  owner         User        @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([ownerId, status])
  @@index([status, expiresAt])
}

model Contract {
  id               String               @id @default(cuid())
  contractNo       String               @unique
  title            String
  amount           Decimal              @db.Decimal(18, 2)
  status           ContractStatus       @default(DRAFT)
  startDate        DateTime
  endDate          DateTime
  signedAt         DateTime?
  notes            String?
  customerId       String
  opportunityId    String
  ownerId          String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  customer         Customer             @relation("CustomerContracts", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity      Opportunity          @relation("OpportunityContracts", fields: [opportunityId], references: [id], onDelete: Cascade)
  owner            User                 @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  paymentPlans     PaymentPlan[]
  paymentRecords   PaymentRecord[]
  renewalReminders RenewalReminder[]

  @@index([customerId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([ownerId, status])
  @@index([status, endDate])
}

model PaymentPlan {
  id            String            @id @default(cuid())
  title         String
  plannedAmount Decimal           @db.Decimal(18, 2)
  receivedAmount Decimal          @default(0) @db.Decimal(18, 2)
  plannedDate   DateTime
  status        PaymentPlanStatus @default(PENDING)
  notes         String?
  customerId    String
  opportunityId String
  contractId    String?
  ownerId       String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  customer      Customer          @relation("CustomerPaymentPlans", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity       @relation("OpportunityPaymentPlans", fields: [opportunityId], references: [id], onDelete: Cascade)
  contract      Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  owner         User              @relation("PaymentPlanOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  paymentRecords PaymentRecord[]

  @@index([customerId, plannedDate])
  @@index([opportunityId, plannedDate])
  @@index([contractId])
  @@index([ownerId, status])
  @@index([status, plannedDate])
}

model PaymentRecord {
  id            String      @id @default(cuid())
  amount        Decimal     @db.Decimal(18, 2)
  receivedAt    DateTime
  note          String?
  customerId    String
  opportunityId String
  contractId    String?
  paymentPlanId String
  ownerId       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer    @relation("CustomerPaymentRecords", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation("OpportunityPaymentRecords", fields: [opportunityId], references: [id], onDelete: Cascade)
  contract      Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  paymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  owner         User        @relation("PaymentRecordOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([customerId, receivedAt])
  @@index([opportunityId, receivedAt])
  @@index([contractId])
  @@index([paymentPlanId, receivedAt])
  @@index([ownerId])
}

model RenewalReminder {
  id            String                @id @default(cuid())
  title         String
  remindAt      DateTime
  status        RenewalReminderStatus @default(PENDING)
  note          String?
  customerId    String
  opportunityId String?
  contractId    String
  ownerId       String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  customer      Customer              @relation("CustomerRenewalReminders", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?          @relation("OpportunityRenewalReminders", fields: [opportunityId], references: [id], onDelete: SetNull)
  contract      Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  owner         User                  @relation("RenewalReminderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([customerId, remindAt])
  @@index([opportunityId, remindAt])
  @@index([contractId, remindAt])
  @@index([ownerId, status])
  @@index([status, remindAt])
}

model FollowUp {
  id             String             @id @default(cuid())
  entityType     FollowUpEntityType
  content        String
  nextFollowUpAt DateTime?
  leadId         String?
  customerId     String?
  createdById    String
  createdAt      DateTime           @default(now())
  createdBy      User               @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lead           Lead?              @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer?          @relation("CustomerFollowUps", fields: [customerId], references: [id], onDelete: Cascade)
  reminder       Reminder?

  @@index([leadId])
  @@index([customerId])
}

model Reminder {
  id         String             @id @default(cuid())
  entityType FollowUpEntityType
  remindAt   DateTime
  status     ReminderStatus     @default(PENDING)
  leadId     String?
  customerId String?
  followUpId String?            @unique
  ownerId    String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  lead       Lead?              @relation("LeadReminders", fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation("CustomerReminders", fields: [customerId], references: [id], onDelete: Cascade)
  followUp   FollowUp?          @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  owner      User               @relation("ReminderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([status])
}

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String?
  actorName  String?
  actionType AuditActionType
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime        @default(now())
  actor      User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actionType])
  @@index([targetType])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model WorkfeedNotificationRead {
  id               String   @id @default(cuid())
  userId           String
  notificationType String
  sourceId         String
  readAt           DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation("WorkfeedNotificationReader", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType, sourceId])
  @@index([userId, readAt])
  @@index([notificationType, sourceId])
}

model LeaveRequest {
  id          String                @id @default(cuid())
  applicantId String
  approverId  String
  leaveType   String
  startAt     DateTime
  endAt       DateTime
  reason      String
  status      LeaveRequestStatus    @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  applicant   User                  @relation("LeaveRequestApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  approver    User                  @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: Restrict)
  actions     LeaveApprovalAction[]

  @@index([applicantId, createdAt])
  @@index([approverId, status])
  @@index([status])
}

model LeaveApprovalAction {
  id             String                 @id @default(cuid())
  leaveRequestId String
  actorId        String
  decision       ApprovalActionDecision
  comment        String?
  createdAt      DateTime               @default(now())
  leaveRequest   LeaveRequest           @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  actor          User                   @relation("LeaveApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([leaveRequestId, createdAt])
  @@index([actorId])
}

model AdministrativeRequest {
  id              String                      @id @default(cuid())
  requestNo       String                      @unique
  type            AdministrativeRequestType
  title           String
  summary         String
  reason          String
  formData        Json
  attachmentNames Json?
  applicantId     String
  approverId      String
  status          AdministrativeRequestStatus @default(PENDING)
  submittedAt     DateTime                    @default(now())
  decidedAt       DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  applicant       User                        @relation("AdministrativeRequestApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  approver        User                        @relation("AdministrativeRequestApprover", fields: [approverId], references: [id], onDelete: Restrict)
  actions         AdministrativeRequestAction[]

  @@index([applicantId, createdAt])
  @@index([approverId, status])
  @@index([type, status])
  @@index([submittedAt])
}

model AdministrativeRequestAction {
  id        String                          @id @default(cuid())
  requestId String
  actorId   String
  actionType AdministrativeRequestActionType
  comment   String?
  snapshot  Json?
  createdAt DateTime                        @default(now())
  request   AdministrativeRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User                            @relation("AdministrativeRequestActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId])
}

model Announcement {
  id            String       @id @default(cuid())
  title         String
  summary       String?
  content       String
  status        RecordStatus @default(ACTIVE)
  publishedById String
  publishedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  publishedBy   User         @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([publishedById])
}

model DictionaryEntry {
  id        String   @id @default(cuid())
  type      String
  label     String
  value     String
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type, enabled])
}

model Attachment {
  id              String                    @id @default(cuid())
  businessType    AttachmentBusinessType
  businessId      String
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  storageProvider AttachmentStorageProvider @default(LOCAL)
  storageKey      String
  customerId      String?
  leadId          String?
  uploadedById    String
  createdAt       DateTime                  @default(now())
  customer        Customer?                 @relation("CustomerAttachments", fields: [customerId], references: [id], onDelete: Cascade)
  lead            Lead?                     @relation("LeadAttachments", fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy      User                      @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([businessType, businessId])
  @@index([uploadedById])
}
