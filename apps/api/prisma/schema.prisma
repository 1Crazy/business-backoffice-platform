model WorkflowTemplate {
  id               String                 @id @default(cuid())
  tenantId         String?
  key              String                 @unique
  name             String
  description      String?
  businessType     String
  version          Int                    @default(1)
  status           WorkflowTemplateStatus @default(DRAFT)
  formSchema       Json
  defaultCcUserIds Json?
  createdById      String
  updatedById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy        User                   @relation("WorkflowTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User                   @relation("WorkflowTemplateUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  nodes            WorkflowTemplateNode[]
  instances        WorkflowInstance[]

  @@index([tenantId])
  @@index([businessType, status])
}

model WorkflowTemplateNode {
  id               String                 @id @default(cuid())
  tenantId         String?
  templateId       String
  nodeKey          String
  name             String
  nodeType         WorkflowNodeType       @default(APPROVAL)
  position         Int
  assignmentType   WorkflowAssignmentType
  assignmentConfig Json
  branchRules      Json?
  fallbackNodeKey  String?
  allowAddSign     Boolean                @default(true)
  allowTransfer    Boolean                @default(true)
  ccUserIds        Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  template         WorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks            WorkflowTask[]

  @@unique([templateId, nodeKey])
  @@unique([templateId, position])
  @@index([tenantId])
  @@index([templateId, position])
}

model WorkflowInstance {
  id             String                 @id @default(cuid())
  tenantId       String?
  templateId     String
  applicantId    String
  businessKey    String?
  title          String
  formData       Json
  currentNodeKey String?
  status         WorkflowInstanceStatus @default(IN_PROGRESS)
  submittedAt    DateTime               @default(now())
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  template       WorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  applicant      User                   @relation("WorkflowInstanceApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  tasks          WorkflowTask[]
  actions        WorkflowAction[]
  ccRecipients   WorkflowCcRecipient[]

  @@index([tenantId])
  @@index([templateId, status])
  @@index([applicantId, submittedAt])
  @@index([status, submittedAt])
}

model WorkflowTask {
  id             String                @id @default(cuid())
  tenantId       String?
  instanceId     String
  templateNodeId String?
  nodeKey        String
  nodeName       String
  assigneeId     String
  createdById    String?
  sourceTaskId   String?
  isAddSign      Boolean               @default(false)
  status         WorkflowTaskStatus    @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  instance       WorkflowInstance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templateNode   WorkflowTemplateNode? @relation(fields: [templateNodeId], references: [id], onDelete: SetNull)
  assignee       User                  @relation("WorkflowTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy      User?                 @relation("WorkflowTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceTask     WorkflowTask?         @relation("WorkflowTaskDerivation", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  derivedTasks   WorkflowTask[]        @relation("WorkflowTaskDerivation")
  actions        WorkflowAction[]

  @@index([tenantId])
  @@index([instanceId, nodeKey, status])
  @@index([assigneeId, status, createdAt])
  @@index([templateNodeId])
  @@index([sourceTaskId])
}

model WorkflowAction {
  id         String             @id @default(cuid())
  tenantId   String?
  instanceId String
  taskId     String?
  actorId    String
  actionType WorkflowActionType
  comment    String?
  payload    Json?
  createdAt  DateTime           @default(now())
  tenant     Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  instance   WorkflowInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  task       WorkflowTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor      User               @relation("WorkflowActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([instanceId, createdAt])
  @@index([actorId, createdAt])
  @@index([taskId])
}

model WorkflowCcRecipient {
