  updatedAt     DateTime         @updatedAt
  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  instance      WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
