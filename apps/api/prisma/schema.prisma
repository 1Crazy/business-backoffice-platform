  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tenant        Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor         User?                   @relation("NotificationEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  notifications NotificationRecord[]

  @@index([tenantId])
  @@index([domain, occurredAt])
  @@index([eventType, occurredAt])
  @@index([sourceType, sourceId])
  @@index([status, createdAt])
  @@index([actorId, createdAt])
}

model NotificationRecord {
  id                 String                   @id @default(cuid())
  tenantId           String?
  eventId            String
  recipientId        String
  domain             NotificationDomain
  eventType          String
  title              String
  summary            String?
  priority           NotificationPriority     @default(MEDIUM)
  status             NotificationRecordStatus @default(UNREAD)
  targetPath         String?
  targetLabel        String?
  channelPreferences Json?
  routingSnapshot    Json?
  deliveredAt        DateTime?
  readAt             DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  event              NotificationEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
