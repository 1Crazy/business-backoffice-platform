generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum DataScope {
  SELF
  DEPARTMENT
  DEPARTMENT_AND_SUBTREE
  ALL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum OpportunityStage {
  DISCOVERY
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentPlanStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum RenewalReminderStatus {
  PENDING
  CONTACTED
  COMPLETED
  DISMISSED
}

enum FollowUpEntityType {
  LEAD
  CUSTOMER
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

enum AuditActionType {
  SIGN_IN
  SIGN_IN_FAILED
  ACCESS
  ACCESS_DENIED
  CREATE
  UPDATE
  DELETE
  ENABLE
  DISABLE
  ASSIGN
  CONVERT
  UPLOAD
  DOWNLOAD
  PREVIEW
  WEBHOOK_DELIVERY
  WEBHOOK_DELIVERY_FAILED
  SESSION_REVOKE
}

enum AttachmentBusinessType {
  CUSTOMER
  LEAD
  OTHER
}

enum AttachmentStorageProvider {
  LOCAL
  OBJECT_STORAGE
}

enum BatchTaskCategory {
  IMPORT
  EXPORT
}

enum BatchTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum GovernanceHealthStatus {
  HEALTHY
  WARNING
  ERROR
}

enum OpenApiCredentialStatus {
  ACTIVE
  REVOKED
}

enum WebhookSubscriptionStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum IdentityConnectorType {
  SSO
  LDAP
  OAUTH
}

enum IdentityConnectorMatchField {
  USERNAME
  EMAIL
}

enum SchedulerJobStatus {
  RUNNING
  PAUSED
}

enum SchedulerExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdministrativeRequestType {
  REIMBURSEMENT
  TRAVEL
  PURCHASE
  SEAL
}

enum AdministrativeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdministrativeRequestActionType {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionDecision {
  APPROVED
  REJECTED
}

enum WorkflowTemplateStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum WorkflowNodeType {
  APPROVAL
  NOTICE
}

enum WorkflowAssignmentType {
  USER
  PERMISSION
  INITIATOR
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  TERMINATED
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  TRANSFERRED
  CANCELLED
}

enum WorkflowActionType {
  SUBMITTED
  APPROVED
  REJECTED
  CC
  ADDED_SIGN
  TRANSFERRED
  CANCELLED
  TERMINATED
}

enum NotificationDomain {
  OA
  SCRM
  PLATFORM
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationEventStatus {
  PENDING
  ROUTED
  CANCELLED
}

enum NotificationRecordStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  ENTERPRISE_IM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationDigestMode {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY
}

enum ProductConfigLayer {
  PLATFORM_DEFAULT
  INDUSTRY_TEMPLATE
  TENANT_OVERRIDE
}

enum ProductConfigScope {
  MENU
  FIELD_SCHEME
  FORM_TEMPLATE
  THEME
  TEMPLATE
}

model Tenant {
  id                          String                        @id @default(cuid())
  code                        String                        @unique
  name                        String
  status                      RecordStatus                  @default(ACTIVE)
  isDefault                   Boolean                       @default(false)
  industry                    String?
  planName                    String                        @default("标准版")
  ownerName                   String                        @default("平台运营")
  ownerEmail                  String                        @default("platform@example.com")
  ownerPhone                  String?
  initializedAt               DateTime?
  disabledAt                  DateTime?
  archivedAt                  DateTime?
  userQuota                   Int                           @default(50)
  storageQuotaMb              Int                           @default(5120)
  monthlyTaskQuota            Int                           @default(10000)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  ProductConfig               ProductConfig[]
  Department                  Department[]
  User                        User[]
  Role                        Role[]
  Customer                    Customer[]
  CustomerTag                 CustomerTag[]
  Lead                        Lead[]
  Opportunity                 Opportunity[]
  OpportunityStageHistory     OpportunityStageHistory[]
  Quote                       Quote[]
  Contract                    Contract[]
  PaymentPlan                 PaymentPlan[]
  PaymentRecord               PaymentRecord[]
  RenewalReminder             RenewalReminder[]
  FollowUp                    FollowUp[]
  Reminder                    Reminder[]
  AuditLog                    AuditLog[]
  UserSession                 UserSession[]
  WorkfeedNotificationRead    WorkfeedNotificationRead[]
  NotificationEvent           NotificationEvent[]
  NotificationRecord          NotificationRecord[]
  NotificationPreference      NotificationPreference[]
  BatchTask                   BatchTask[]
  LeaveRequest                LeaveRequest[]
  LeaveApprovalAction         LeaveApprovalAction[]
  AdministrativeRequest       AdministrativeRequest[]
  AdministrativeRequestAction AdministrativeRequestAction[]
  WorkflowTemplate            WorkflowTemplate[]
  WorkflowTemplateNode        WorkflowTemplateNode[]
  WorkflowInstance            WorkflowInstance[]
  WorkflowTask                WorkflowTask[]
  WorkflowAction              WorkflowAction[]
  WorkflowCcRecipient         WorkflowCcRecipient[]
  Announcement                Announcement[]
  DictionaryEntry             DictionaryEntry[]
  Attachment                  Attachment[]
  OpenApiCredential           OpenApiCredential[]
  WebhookSubscription         WebhookSubscription[]
  WebhookDelivery             WebhookDelivery[]
  IdentityConnector           IdentityConnector[]
  IdentityConnectorBinding    IdentityConnectorBinding[]
}

model ProductConfig {
  id           String             @id @default(cuid())
  code         String             @unique
  tenantId     String?
  industryCode String?
  layer        ProductConfigLayer
  scope        ProductConfigScope
  configKey    String
  displayName  String
  description  String?
  value        Json
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([industryCode])
  @@index([layer, scope])
  @@index([configKey])
}

model Department {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  code      String       @unique
  parentId  String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentHierarchy")
  users     User[]

  @@index([tenantId])
  @@index([parentId])
  @@index([status])
}

model User {
  id                        String                        @id @default(cuid())
  tenantId                  String
  username                  String                        @unique
  passwordHash              String
  displayName               String
  email                     String?
  phone                     String?
  status                    UserStatus                    @default(ACTIVE)
  departmentId              String?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  tenant                    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department                Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                     UserRole[]
  ownedCustomers            Customer[]                    @relation("CustomerOwner")
  ownedLeads                Lead[]                        @relation("LeadOwner")
  ownedOpportunities        Opportunity[]                 @relation("OpportunityOwner")
  followUps                 FollowUp[]                    @relation("FollowUpCreator")
  reminders                 Reminder[]                    @relation("ReminderOwner")
  auditLogs                 AuditLog[]                    @relation("AuditActor")
  uploadedAttachments       Attachment[]                  @relation("AttachmentUploader")
  sessions                  UserSession[]
  leaveRequests             LeaveRequest[]                @relation("LeaveRequestApplicant")
  approvalsToHandle         LeaveRequest[]                @relation("LeaveRequestApprover")
  leaveApprovalActions      LeaveApprovalAction[]         @relation("LeaveApprovalActor")
  administrativeRequests    AdministrativeRequest[]       @relation("AdministrativeRequestApplicant")
  administrativeApprovals   AdministrativeRequest[]       @relation("AdministrativeRequestApprover")
  administrativeActions     AdministrativeRequestAction[] @relation("AdministrativeRequestActionActor")
  opportunityStageHistories OpportunityStageHistory[]     @relation("OpportunityStageHistoryCreator")
  ownedQuotes               Quote[]                       @relation("QuoteOwner")
  ownedContracts            Contract[]                    @relation("ContractOwner")
  ownedPaymentPlans         PaymentPlan[]                 @relation("PaymentPlanOwner")
  ownedPaymentRecords       PaymentRecord[]               @relation("PaymentRecordOwner")
  ownedRenewalReminders     RenewalReminder[]             @relation("RenewalReminderOwner")
  publishedAnnouncements    Announcement[]                @relation("AnnouncementPublisher")
  workfeedNotificationReads WorkfeedNotificationRead[]    @relation("WorkfeedNotificationReader")
  notificationEvents        NotificationEvent[]           @relation("NotificationEventActor")
  notificationRecords       NotificationRecord[]          @relation("NotificationRecordRecipient")
  notificationPreferences   NotificationPreference[]      @relation("NotificationPreferenceUser")
  batchTasks                BatchTask[]                   @relation("BatchTaskOperator")
  createdWorkflowTemplates  WorkflowTemplate[]            @relation("WorkflowTemplateCreator")
  updatedWorkflowTemplates  WorkflowTemplate[]            @relation("WorkflowTemplateUpdater")
  workflowInstances         WorkflowInstance[]            @relation("WorkflowInstanceApplicant")
  assignedWorkflowTasks     WorkflowTask[]                @relation("WorkflowTaskAssignee")
  createdWorkflowTasks      WorkflowTask[]                @relation("WorkflowTaskCreator")
  workflowActions           WorkflowAction[]              @relation("WorkflowActionActor")
  workflowCcRecipients      WorkflowCcRecipient[]         @relation("WorkflowCcRecipientUser")
  createdWorkflowCcEntries  WorkflowCcRecipient[]         @relation("WorkflowCcRecipientCreator")
  identityConnectorBindings IdentityConnectorBinding[]

  @@index([tenantId])
  @@index([departmentId])
  @@index([status])
}

model Role {
  id                    String           @id @default(cuid())
  tenantId              String
  name                  String
  code                  String           @unique
  description           String?
  isSystem              Boolean          @default(false)
  status                RecordStatus     @default(ACTIVE)
  dataScope             DataScope        @default(SELF)
  extendedDataScopes    Json?
  fieldPermissionRules  Json?
  actionPermissionRules Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users                 UserRole[]
  permissions           RolePermission[]

  @@index([tenantId])
  @@index([dataScope])
  @@index([status])
}

model Permission {
  id          String           @id @default(cuid())
  appCode     String           @default("scrm")
  name        String
  code        String           @unique
  description String?
  group       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([appCode, group])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Customer {
  id                 String                  @id @default(cuid())
  tenantId           String
  name               String
  contactName        String?
  phone              String?
  email              String?
  source             String?
  status             String?
  notes              String?
  ownerId            String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner              User                    @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tags               CustomerTagOnCustomer[]
  followUps          FollowUp[]              @relation("CustomerFollowUps")
  reminders          Reminder[]              @relation("CustomerReminders")
  attachments        Attachment[]            @relation("CustomerAttachments")
  opportunities      Opportunity[]
  quotes             Quote[]                 @relation("CustomerQuotes")
  contracts          Contract[]              @relation("CustomerContracts")
  paymentPlans       PaymentPlan[]           @relation("CustomerPaymentPlans")
  paymentRecords     PaymentRecord[]         @relation("CustomerPaymentRecords")
  renewalReminders   RenewalReminder[]       @relation("CustomerRenewalReminders")
  convertedFromLeads Lead[]                  @relation("LeadConvertedCustomer")

  @@index([tenantId])
  @@index([ownerId])
  @@index([source])
  @@index([status])
}

model CustomerTag {
  id        String                  @id @default(cuid())
  tenantId  String
  name      String                  @unique
  color     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customers CustomerTagOnCustomer[]

  @@index([tenantId])
}

model CustomerTagOnCustomer {
  customerId String
  tagId      String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model Lead {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  contactName         String?
  phone               String?
  source              String?
  status              LeadStatus    @default(NEW)
  notes               String?
  ownerId             String
  convertedCustomerId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner               User          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  convertedCustomer   Customer?     @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  followUps           FollowUp[]    @relation("LeadFollowUps")
  reminders           Reminder[]    @relation("LeadReminders")
  attachments         Attachment[]  @relation("LeadAttachments")
  sourceOpportunities Opportunity[] @relation("LeadSourceOpportunity")

  @@index([tenantId])
  @@index([ownerId])
  @@index([source])
  @@index([status])
}

model Opportunity {
  id                String                    @id @default(cuid())
  tenantId          String
  name              String
  customerId        String
  sourceLeadId      String?
  ownerId           String
  stage             OpportunityStage          @default(DISCOVERY)
  expectedAmount    Decimal                   @db.Decimal(18, 2)
  expectedCloseDate DateTime
  nextAction        String
  notes             String?
  closedAt          DateTime?
  lostReason        String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer          Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceLead        Lead?                     @relation("LeadSourceOpportunity", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  owner             User                      @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  stageHistory      OpportunityStageHistory[]
  quotes            Quote[]                   @relation("OpportunityQuotes")
  contracts         Contract[]                @relation("OpportunityContracts")
  paymentPlans      PaymentPlan[]             @relation("OpportunityPaymentPlans")
  paymentRecords    PaymentRecord[]           @relation("OpportunityPaymentRecords")
  renewalReminders  RenewalReminder[]         @relation("OpportunityRenewalReminders")

  @@index([tenantId])
  @@index([ownerId])
  @@index([customerId])
  @@index([sourceLeadId])
  @@index([createdAt])
  @@index([stage, expectedCloseDate])
  @@index([stage, closedAt])
}

model OpportunityStageHistory {
  id            String            @id @default(cuid())
  tenantId      String
  opportunityId String
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  comment       String?
  createdById   String
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy     User              @relation("OpportunityStageHistoryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([opportunityId, createdAt])
  @@index([createdById])
}

model Quote {
  id            String      @id @default(cuid())
  tenantId      String
  quoteNo       String      @unique
  title         String
  amount        Decimal     @db.Decimal(18, 2)
  status        QuoteStatus @default(DRAFT)
  issuedAt      DateTime?
  expiresAt     DateTime?
  notes         String?
  customerId    String
  opportunityId String
  ownerId       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer    @relation("CustomerQuotes", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation("OpportunityQuotes", fields: [opportunityId], references: [id], onDelete: Cascade)
  owner         User        @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([ownerId, status])
  @@index([status, expiresAt])
}

model Contract {
  id               String            @id @default(cuid())
  tenantId         String
  contractNo       String            @unique
  title            String
  amount           Decimal           @db.Decimal(18, 2)
  status           ContractStatus    @default(DRAFT)
  startDate        DateTime
  endDate          DateTime
  signedAt         DateTime?
  notes            String?
  customerId       String
  opportunityId    String
  ownerId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer         Customer          @relation("CustomerContracts", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity      Opportunity       @relation("OpportunityContracts", fields: [opportunityId], references: [id], onDelete: Cascade)
  owner            User              @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  paymentPlans     PaymentPlan[]
  paymentRecords   PaymentRecord[]
  renewalReminders RenewalReminder[]

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([ownerId, status])
  @@index([status, endDate])
}

model PaymentPlan {
  id             String            @id @default(cuid())
  tenantId       String
  title          String
  plannedAmount  Decimal           @db.Decimal(18, 2)
  receivedAmount Decimal           @default(0) @db.Decimal(18, 2)
  plannedDate    DateTime
  status         PaymentPlanStatus @default(PENDING)
  notes          String?
  customerId     String
  opportunityId  String
  contractId     String?
  ownerId        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer          @relation("CustomerPaymentPlans", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity    Opportunity       @relation("OpportunityPaymentPlans", fields: [opportunityId], references: [id], onDelete: Cascade)
  contract       Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  owner          User              @relation("PaymentPlanOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  paymentRecords PaymentRecord[]

  @@index([tenantId])
  @@index([customerId, plannedDate])
  @@index([opportunityId, plannedDate])
  @@index([contractId])
  @@index([ownerId, status])
  @@index([status, plannedDate])
}

model PaymentRecord {
  id            String      @id @default(cuid())
  tenantId      String
  amount        Decimal     @db.Decimal(18, 2)
  receivedAt    DateTime
  note          String?
  customerId    String
  opportunityId String
  contractId    String?
  paymentPlanId String
  ownerId       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer    @relation("CustomerPaymentRecords", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation("OpportunityPaymentRecords", fields: [opportunityId], references: [id], onDelete: Cascade)
  contract      Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  paymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  owner         User        @relation("PaymentRecordOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId, receivedAt])
  @@index([opportunityId, receivedAt])
  @@index([contractId])
  @@index([paymentPlanId, receivedAt])
  @@index([ownerId])
}

model RenewalReminder {
  id            String                @id @default(cuid())
  tenantId      String
  title         String
  remindAt      DateTime
  status        RenewalReminderStatus @default(PENDING)
  note          String?
  customerId    String
  opportunityId String?
  contractId    String
  ownerId       String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer              @relation("CustomerRenewalReminders", fields: [customerId], references: [id], onDelete: Cascade)
  opportunity   Opportunity?          @relation("OpportunityRenewalReminders", fields: [opportunityId], references: [id], onDelete: SetNull)
  contract      Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  owner         User                  @relation("RenewalReminderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId, remindAt])
  @@index([opportunityId, remindAt])
  @@index([contractId, remindAt])
  @@index([ownerId, status])
  @@index([status, remindAt])
}

model FollowUp {
  id             String             @id @default(cuid())
  tenantId       String
  entityType     FollowUpEntityType
  content        String
  nextFollowUpAt DateTime?
  leadId         String?
  customerId     String?
  createdById    String
  createdAt      DateTime           @default(now())
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lead           Lead?              @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer?          @relation("CustomerFollowUps", fields: [customerId], references: [id], onDelete: Cascade)
  reminder       Reminder?

  @@index([tenantId])
  @@index([leadId])
  @@index([customerId])
}

model Reminder {
  id         String             @id @default(cuid())
  tenantId   String
  entityType FollowUpEntityType
  remindAt   DateTime
  status     ReminderStatus     @default(PENDING)
  leadId     String?
  customerId String?
  followUpId String?            @unique
  ownerId    String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead       Lead?              @relation("LeadReminders", fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation("CustomerReminders", fields: [customerId], references: [id], onDelete: Cascade)
  followUp   FollowUp?          @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  owner      User               @relation("ReminderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
}

model AuditLog {
  id         String          @id @default(cuid())
  tenantId   String
  actorId    String?
  actorName  String?
  actionType AuditActionType
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime        @default(now())
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor      User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
