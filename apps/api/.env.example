# API 服务端口
PORT=3000
# JWT 签名密钥；生产必须替换为至少 32 位随机字符串
JWT_SECRET=change-me-to-at-least-32-random-characters
# 访问令牌有效期；启动期限制不得超过 30 分钟
JWT_ACCESS_TOKEN_TTL=30m
# PostgreSQL 连接串；本地开发默认通过 docker-compose.dev.yml 暴露的 5433 访问
DATABASE_URL=postgresql://scrm:scrm@localhost:5433/scrm?schema=public
# 生产必须显式配置允许的前端来源列表
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:8080,http://localhost:8081,http://localhost:8082
# 风险限流存储；生产必须为 database
RISK_THROTTLE_STORE=database
# Swagger 开关；非本地环境开启时必须配合 Basic Auth
SWAGGER_ENABLED=true
SWAGGER_BASIC_AUTH_USERNAME=change-me-docs-user
SWAGGER_BASIC_AUTH_PASSWORD=change-me-docs-password
# 身份连接器 mock 登录只允许本地联调用
ALLOW_MOCK_CONNECTOR_LOGIN=true
# Webhook 测试模式：REAL 表示真实投递，SIMULATION 表示模拟结果
WEBHOOK_TEST_MODE=REAL
# 真实 Webhook 测试 / 投递允许访问的目标域名白名单
WEBHOOK_ALLOWED_DOMAINS=*.trusted.test
# Open API / 连接器 secret HMAC pepper；生产必须独立随机
OPEN_INTEGRATION_SECRET_PEPPER=change-me-to-random-open-integration-pepper
# Webhook signing secret 与可回读 provider secret 的应用级加密密钥
OPEN_INTEGRATION_SECRET_ENCRYPTION_KEY=change-me-to-random-32-byte-base64url-key-or-long-passphrase
# 附件存储驱动：local 或 object-storage
ATTACHMENT_STORAGE_DRIVER=local
# 附件扫描模式；生产应切到真实扫描器
ATTACHMENT_SCAN_MODE=stub
# 扫描器错误时是否直接拒绝上传；生产建议 true
ATTACHMENT_SCAN_FAIL_CLOSED=false
ATTACHMENT_OBJECT_STORAGE_ROOT=object-storage
ATTACHMENT_OBJECT_STORAGE_BUCKET=attachments
ATTACHMENT_OBJECT_STORAGE_PREFIX=business-backoffice
# 密码重置邮件里对外展示的重置页面基础地址
PASSWORD_RESET_PUBLIC_BASE_URL=https://portal.example.com
# 邮件出站 provider；当前实现默认支持 resend 风格 API
EMAIL_DELIVERY_PROVIDER=resend
# 邮件 provider API Key；生产必须配置真实值
EMAIL_RESEND_API_KEY=change-me-resend-api-key
# 邮件 provider API 地址；默认指向 Resend 官方接口
EMAIL_RESEND_API_URL=https://api.resend.com/emails
# 系统发件人地址；生产必须使用已验证域名邮箱
EMAIL_FROM_ADDRESS=noreply@example.com
# 回复邮箱；建议指向客服或管理员邮箱
EMAIL_REPLY_TO=support@example.com
# 邮件正文中的相对链接拼装基础地址
EMAIL_LINK_BASE_URL=https://portal.example.com
# 企业 IM 机器人 Webhook 地址；生产配置后可用于治理告警等高优通知
ENTERPRISE_IM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=change-me
# 企业 IM Webhook 签名密钥；如果机器人启用了签名校验则必填
ENTERPRISE_IM_WEBHOOK_SECRET=change-me-enterprise-im-secret
# 企业 IM 文案中的相对链接拼装基础地址
ENTERPRISE_IM_LINK_BASE_URL=https://portal.example.com
